APP_NAME=NazishAI File Platform
ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/nazishai
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_CHUNKS=nazishai-chunks
S3_BUCKET_FILES=nazishai-files
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=nazishai_documents
CHUNK_SIZE_DEFAULT=104857600
CHUNK_SIZE_MAX=536870912
MAX_FILE_SIZE=1099511627776
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
